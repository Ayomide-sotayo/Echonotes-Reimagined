# ==============================================================================
# EchoNotes Environment Configuration Template
# 
# Instructions:
# 1. Copy this template to .env:
#      cp .env.example .env
# 2. Fill in your development API keys and tokens.
# 3. Keep .env strictly private and NEVER commit it to source control.
# ==============================================================================

# AssemblyAI API key for audio transcription (speech-to-text)
# Obtain your key at: https://www.assemblyai.com/
ASSEMBLY_AI_KEY=your_assemblyai_api_key_here

# Firebase App Check Android Debug Token
# Required for testing on physical Android devices or emulators with App Check enabled
# Generate / register in Firebase Console -> App Check -> Apps -> Manage debug tokens
APP_CHECK_DEBUG_TOKEN=your_firebase_app_check_debug_token_here

# Google OAuth Web Client ID (client_type: 3 from Firebase / Google Cloud Console)
# Used for Android Google Sign-In with Firebase Authentication
GOOGLE_WEB_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com

# Optional Hugging Face Token (if using secondary AI models)
HUGGING_FACE_TOKEN=your_hugging_face_token_here
